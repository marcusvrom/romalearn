# ---------------------------------------------------------------------------
# RomaLearn — exemplo de configuração.
# Copie para `.env` (`cp .env.example .env`) e ajuste conforme necessário.
# Este arquivo NÃO deve conter segredos reais. Os valores abaixo são
# exclusivamente para o ambiente local de desenvolvimento.
# ---------------------------------------------------------------------------

# ----- Aplicação -----------------------------------------------------------
NODE_ENV=development
API_PORT=3333
API_GLOBAL_PREFIX=api
# URL pública da API (usada em links de e-mail e no QR Code do certificado)
API_PUBLIC_URL=http://localhost:3333
# URL pública do site (usada em links de e-mail e URLs de validação)
WEB_PUBLIC_URL=http://localhost:4200
# Origens permitidas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:4200,http://localhost:4000

# ----- Identidade da plataforma -------------------------------------------
# Centraliza nome/identidade: nada disso deve ser escrito direto no código.
PLATFORM_NAME=RomaLearn
PLATFORM_LEGAL_NAME="RomaLearn Educação"
PLATFORM_SUPPORT_EMAIL=suporte@romalearn.local
PLATFORM_CERTIFICATE_ISSUER="RomaLearn Educação"

# ----- Banco de dados ------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=romalearn
POSTGRES_PASSWORD=romalearn
POSTGRES_DB=romalearn
# Banco separado usado por `pnpm test:e2e`
POSTGRES_TEST_DB=romalearn_test
DATABASE_SSL=false

# ----- Autenticação --------------------------------------------------------
# Gere valores próprios com: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Domínio/flags dos cookies de sessão (HttpOnly sempre ativo)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ----- E-mail --------------------------------------------------------------
# console | smtp
MAIL_DRIVER=smtp
MAIL_FROM_NAME=RomaLearn
MAIL_FROM_ADDRESS=nao-responda@romalearn.local
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# ----- Armazenamento (S3 compatível / MinIO) -------------------------------
# s3 | local
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=romalearn
STORAGE_ACCESS_KEY=romalearn
STORAGE_SECRET_KEY=romalearn123
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=http://localhost:9000/romalearn
STORAGE_SIGNED_URL_TTL=900
STORAGE_MAX_UPLOAD_BYTES=20971520

# ----- Pagamentos ----------------------------------------------------------
# fake | mercadopago
PAYMENT_GATEWAY=fake
PAYMENT_CURRENCY=BRL
# Segredo usado para assinar/validar webhooks do gateway fake
PAYMENT_FAKE_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
# Mercado Pago (deixe vazio enquanto não houver credenciais de sandbox)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# ----- Seed local ----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@romalearn.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME="Administrador Local"
# Cria aluno + matrícula demonstrativa (somente fora de produção)
SEED_DEMO_STUDENT=true
SEED_DEMO_STUDENT_EMAIL=aluno@romalearn.local
SEED_DEMO_STUDENT_PASSWORD=Aluno@123456
# Senha única das contas de teste manual criadas por `pnpm seed:demo`
SEED_DEMO_PASSWORD=Senha@123456

# ----- Observabilidade / limites ------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
RATE_LIMIT_AUTH_LIMIT=10
SWAGGER_ENABLED=true
